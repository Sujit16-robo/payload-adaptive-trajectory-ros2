<?xml version="1.0"?>
<robot name="payload_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="payload_mass" default="0.001"/>
  <xacro:property name="payload_mass" value="$(arg payload_mass)"/>
  <xacro:arg name="controllers_file" default=""/>

  <link name="world"/>
  <material name="arm_orange"><color rgba="1.0 0.45 0.0 1.0"/></material>
  <material name="base_grey"><color rgba="0.4 0.4 0.4 1.0"/></material>
  <material name="gripper_dark"><color rgba="0.15 0.15 0.15 1.0"/></material>
  <material name="payload_red"><color rgba="0.8 0.1 0.1 1.0"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><mesh filename="package://payload_arm/meshes/base.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="base_grey"/>
    </visual>
    <collision><geometry><cylinder radius="0.15" length="0.3"/></geometry></collision>
    <inertial>
      <mass value="55.69"/>
      <origin xyz="0 0.0726 0"/>
      <inertia ixx="0.3607" ixy="0" ixz="0" iyy="0.4026" iyz="0" izz="0.3607"/>
    </inertial>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="-0.000056 0.001659 0.02122" rpy="1.5708 0 0"/>
      <geometry><mesh filename="package://payload_arm/meshes/link1.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="arm_orange"/>
    </visual>
    <collision><geometry><cylinder radius="0.15" length="0.25"/></geometry></collision>
    <inertial>
      <mass value="74.13"/>
      <origin xyz="-0.00926 0.0460 0"/>
      <inertia ixx="0.8404" ixy="0.1125" ixz="0" iyy="0.6020" iyz="0" izz="0.9823"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" velocity="1.0" effort="300.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0.093463 -0.11721 0.13671" rpy="3.14159 0.7854 3.14159"/>
      <geometry><mesh filename="package://payload_arm/meshes/link2.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="arm_orange"/>
    </visual>
    <collision><origin xyz="0.325 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.05" length="0.65"/></geometry></collision>
    <inertial>
      <mass value="38.64"/>
      <origin xyz="0.0549 0.0460 0"/>
      <inertia ixx="0.0898" ixy="-0.0828" ixz="0" iyy="1.468" iyz="0" izz="1.477"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" velocity="1.0" effort="1200.0"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="-0.46165 0.000712 0.29" rpy="0 0 0"/>
      <geometry><mesh filename="package://payload_arm/meshes/link3.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="arm_orange"/>
    </visual>
    <collision><origin xyz="0.254 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.045" length="0.508"/></geometry></collision>
    <inertial>
      <mass value="33.60"/>
      <origin xyz="0.2625 -0.0131 0"/>
      <inertia ixx="0.0796" ixy="-0.0780" ixz="0" iyy="0.7627" iyz="0" izz="0.8002"/>
    </inertial>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.65 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" velocity="1.0" effort="500.0"/>
  </joint>

  <link name="end_effector">
    <visual>
      <origin xyz="-1.78817 -0.70265 -0.63291" rpy="1.5708 0 1.5708"/>
      <geometry><mesh filename="package://payload_arm/meshes/gripper.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="gripper_dark"/>
    </visual>
    <collision><geometry><box size="0.15 0.1 0.22"/></geometry></collision>
    <inertial>
      <mass value="10.47"/>
      <origin xyz="0.1 0 0"/>
      <inertia ixx="0.222" ixy="0" ixz="0" iyy="0.241" iyz="0" izz="0.0239"/>
    </inertial>
  </link>

  <joint name="joint_ee" type="fixed">
    <parent link="link3"/>
    <child link="end_effector"/>
    <origin xyz="0.508 0 0" rpy="0 0 0"/>
  </joint>

  <link name="payload_link">
    <visual>
      <geometry><box size="0.07 0.07 0.07"/></geometry>
      <material name="payload_red"/>
    </visual>
    <collision><geometry><box size="0.07 0.07 0.07"/></geometry></collision>
    <inertial>
      <mass value="${payload_mass}"/>
      <inertia ixx="${payload_mass*0.07*0.07/6 + 0.000001}" ixy="0" ixz="0"
               iyy="${payload_mass*0.07*0.07/6 + 0.000001}" iyz="0"
               izz="${payload_mass*0.07*0.07/6 + 0.000001}"/>
    </inertial>
  </link>

  <joint name="joint_payload" type="fixed">
    <parent link="end_effector"/>
    <child link="payload_link"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
  </joint>

  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>joint1</joint_name>
      <topic>/joint1/cmd_pos</topic>
      <p_gain>40000</p_gain>
      <i_gain>200</i_gain>
      <d_gain>3000</d_gain>
      <i_max>5000</i_max>
      <i_min>-5000</i_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>joint2</joint_name>
      <topic>/joint2/cmd_pos</topic>
      <p_gain>80000</p_gain>
      <i_gain>400</i_gain>
      <d_gain>6000</d_gain>
      <i_max>10000</i_max>
      <i_min>-10000</i_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>joint3</joint_name>
      <topic>/joint3/cmd_pos</topic>
      <p_gain>40000</p_gain>
      <i_gain>200</i_gain>
      <d_gain>3000</d_gain>
      <i_max>5000</i_max>
      <i_min>-5000</i_min>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>

</robot>